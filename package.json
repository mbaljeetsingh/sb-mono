{
  "name": "sb-mono",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source live scorecards for racquet sports. Mobile-controlled, OBS-ready, theme-swappable.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/shared/src/types/supabase.ts",
    "shadcn:update": "tsx ./scripts/shadcn/index.ts",
    "shadcn:patches-only": "tsx ./scripts/shadcn/index.ts --patches-only",
    "render-emails": "pnpm --filter @sb/app exec vitest run emails/generate.test.ts",
    "release": "commit-and-tag-version --skip.commit --skip.changelog --skip.tag --release-as patch --packageFiles apps/app/package.json --bumpFiles apps/app/package.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "commit-and-tag-version": "^12.6.1",
    "husky": "^9.1.7",
    "supabase": "^2.101.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.5",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.27",
      "@vue/runtime-core": "^3.5.27",
      "@vue/runtime-dom": "^3.5.27",
      "@vue/reactivity": "^3.5.27",
      "@vue/shared": "^3.5.27",
      "@vue/compiler-dom": "^3.5.27",
      "@vue/compiler-core": "^3.5.27",
      "@vue/compiler-sfc": "^3.5.27",
      "@vue/server-renderer": "^3.5.27"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "sharp",
      "supabase",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.9.6",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  }
}

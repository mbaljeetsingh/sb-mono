{
  "name": "sb-mono",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source live scorecards for racquet sports. Mobile-controlled, OBS-ready, theme-swappable.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/shared/src/types/supabase.ts",
    "supabase:deploy": "./scripts/supabase-deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "supabase": "^2.90.0",
    "turbo": "^2.9.5",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.27",
      "@vue/runtime-core": "^3.5.27",
      "@vue/runtime-dom": "^3.5.27",
      "@vue/reactivity": "^3.5.27",
      "@vue/shared": "^3.5.27",
      "@vue/compiler-dom": "^3.5.27",
      "@vue/compiler-core": "^3.5.27",
      "@vue/compiler-sfc": "^3.5.27",
      "@vue/server-renderer": "^3.5.27"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "sharp",
      "supabase",
      "vue-demi"
    ]
  }
}

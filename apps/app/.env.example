# Local development uses Supabase CLI (pnpm supabase:start)
# These are the well-known local-dev keys printed by the CLI; safe to commit.
# Production values are set in Netlify's env var dashboard.

NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# Services
NUXT_PUBLIC_ENVIRONMENT=development
NUXT_PUBLIC_POSTHOG_KEY=

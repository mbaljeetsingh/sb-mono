# Upload-key signing for the release build — TEMPLATE ONLY.
# The build looks for the real file in this order (android/release-signing.gradle):
#
#   1. $SB_KEYSTORE_DIR/scoreboard-keystore.properties            (override)
#   2. ~/.config/beejaysoft/keys/scoreboard-keystore.properties   (default, use this)
#   3. <this dir>/keystore.properties                             (one-off build)
#
# Set it up once:
#
#   cd ~/.config/beejaysoft/keys
#   keytool -genkeypair -v -keystore scoreboard-upload.keystore \
#     -alias scoreboard-upload -keyalg RSA -keysize 2048 -validity 10000
#   # copy this file there as scoreboard-keystore.properties, fill in the passwords
#   chmod 600 scoreboard-keystore.properties
#
# A bare storeFile resolves against the directory THIS file lives in.
# BACKUP: the .keystore goes in your password manager as an attachment, the
# passwords as separate entries. Losing the upload key is a ~48h Play support
# reset (Play App Signing holds the real signing key), not a catastrophe.

storeFile=scoreboard-upload.keystore
storePassword=
keyAlias=scoreboard-upload
keyPassword=
